@model IEnumerable<OnlineExamination.Models.StudentMasterModel>

@{
    ViewBag.Title = "Student Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Student Management"},
            {"Url", Url.Action("Index", "StudentMaster")},
            {"IsCurrent", true}
        }
    };
}

<!-- Page Header -->
<div class="exam-page-header">
    <h1 class="exam-page-title">Student Master</h1>
    <p class="exam-page-description">Manage student records and information.</p>
</div>

<div class="exam-card">
    <div class="exam-card-header">
        <h2 class="exam-card-title">Student List</h2>
        <p class="exam-card-subtitle">View and manage all student records.</p>
        @Html.ActionLink("Create New", "Create", null, new { @class = "exam-btn exam-btn-primary" })
    </div>
    <div class="exam-card-content">
        <div class="exam-grid exam-grid-cols-1">
            <div class="exam-table-responsive">
                @if (Model == null || !Model.Any())
                {
                    <div class="exam-alert exam-alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        No Data Found
                    </div>
                }
                else
                {
                    <table class="exam-table" id="tblSuntech">
                        <thead class="exam-table-header">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Mobile</th>
                                <th>DOB</th>
                                <th>Gender</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody class="exam-table-body">
                            @foreach (var item in Model)
                            {
                                <tr class="exam-table-row">
                                    <td>@Html.DisplayFor(modelItem => item.Stud_Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Stud_Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Stud_Mobile)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FormattedStudDOB)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Stud_Gender)</td>
                                    <td>
                                        <div class="exam-flex exam-gap-2">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.Stud_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-warning" }) 
                                            @Html.ActionLink("Details", "Details", new { id = item.Stud_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-info" }) 
                                            @* @Html.ActionLink("Delete", "Delete", new { id = item.Stud_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-danger" }) *@
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<!-- Optional: Tooltip Script for Buttons -->
<script>
    var tooltipTriggerList = Array.prototype.slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
</script>
