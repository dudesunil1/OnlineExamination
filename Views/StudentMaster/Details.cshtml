@model OnlineExamination.Models.StudentMasterModel

@{
    ViewBag.Title = "Student Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Student Management"},
            {"Url", Url.Action("Index", "StudentMaster")},
            {"IsCurrent", false}
        },
        new Dictionary<string, object>
        {
            {"Text", "Student Details"},
            {"Url", Url.Action("Details", "StudentMaster")},
            {"IsCurrent", true}
        }
    };
}

<!-- Professional Page Header -->
<div class="exam-page-header-professional">
    <div class="exam-header-content">
        <div class="exam-header-text">
            <h1 class="exam-page-title">Student Details</h1>
            <p class="exam-page-description">View comprehensive student information and profile details</p>
        </div>
        <div class="exam-header-actions">
            <div class="exam-flex exam-gap-3">
                @Html.ActionLink("Back to List", "Index", null, new { @class = "exam-btn exam-btn-secondary exam-btn-lg" })
                @Html.ActionLink("Edit Student", "Edit", new { id = Model.Stud_Id }, new { @class = "exam-btn exam-btn-primary exam-btn-lg" })
            </div>
        </div>
    </div>
</div>

<!-- Student Details Display Start -->
<div class="exam-card">
    <div class="exam-card-content">
        <div class="exam-grid exam-grid-cols-2">
            <!-- Name Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_Name)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_Name
                </div>
            </div>

            <!-- Mobile Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_Mobile)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_Mobile
                </div>
            </div>

            <!-- Date of Birth Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_DOB)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_DOB.ToString("MMM dd, yyyy")
                </div>
            </div>

            <!-- Gender Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_Gender)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_Gender
                </div>
            </div>

            <!-- Photo Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_Photo)
                </label>
                <div class="exam-form-display">
                    @if (!string.IsNullOrEmpty(Model.Stud_Photo))
                    {
                        <img src="@Url.Content("~/Content/StudentPhotos/"+Model.Stud_Id + Model.Stud_Photo)" alt="Student Photo" class="exam-student-photo">
                    }
                    else
                    {
                        <div class="exam-no-photo">
                            <i class="fas fa-user-circle"></i>
                            <span>No photo uploaded</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Username Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_UserName)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_UserName
                </div>
            </div>

            <!-- Password Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_Password)
                </label>
                <div class="exam-form-display">
                    <span class="exam-password-masked">••••••••••</span>
                </div>
            </div>

            <!-- Admission Date Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_AdmissionDate)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_AdmissionDate.ToString("MMM dd, yyyy")
                </div>
            </div>

            <!-- Group Field -->
            <div class="exam-form-group">
                <label class="exam-form-label">
                    @Html.LabelFor(model => model.Stud_Group)
                </label>
                <div class="exam-form-display">
                    @Model.Stud_Group
                </div>
            </div>
        </div>
    </div>
</div>

