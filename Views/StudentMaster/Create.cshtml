@model OnlineExamination.Models.StudentMasterModel

@{
    ViewBag.Title = "Create Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Student Management"},
            {"Url", Url.Action("Index", "StudentMaster")},
            {"IsCurrent", false}
        },
        new Dictionary<string, object>
        {
            {"Text", "Create Student"},
            {"Url", Url.Action("Create", "StudentMaster")},
            {"IsCurrent", true}
        }
    };
}

<!-- Page Header -->
<div class="exam-page-header">
    <h1 class="exam-page-title">Create Student</h1>
    <p class="exam-page-description">Add new student information and academic details.</p>
</div>

@using (Html.BeginForm("Create", "StudentMaster", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    
    <!-- Student Form Start -->
    <div class="exam-card">
        <div class="exam-card-header">
            <h2 class="exam-card-title">Student Information</h2>
            <p class="exam-card-subtitle">Fields marked with <span class="exam-text-red-600">*</span> are mandatory.</p>
        </div>
        <div class="exam-card-content">

            <div class="exam-grid exam-grid-cols-2">
                <!-- Name Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Name)
                        <span class="required">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Stud_Name, new { @class = "exam-form-control" })
                    @Html.ValidationMessageFor(model => model.Stud_Name, "", new { @class = "text-danger" })
                </div>

                <!-- Mobile Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Mobile)
                        <span class="required">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Stud_Mobile, new { type = "number", @class = "exam-form-control" })
                    @Html.ValidationMessageFor(model => model.Stud_Mobile, "", new { @class = "text-danger" })
                </div>

                <!-- Date of Birth Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_DOB)
                    </label>
                    @Html.TextBoxFor(model => model.Stud_DOB, "{0:yyyy-MM-dd}", new { @type = "date", @class = "exam-form-control" })
                    @Html.ValidationMessageFor(model => model.Stud_DOB, "", new { @class = "text-danger" })
                </div>

                <!-- Gender Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Gender)
                    </label>
                    @Html.DropDownListFor(model => model.Stud_Gender, new SelectList(new[] { "Male", "Female", "Other" }), "- Select Gender -", new { @class = "exam-form-select" })
                    @Html.ValidationMessageFor(model => model.Stud_Gender, "", new { @class = "text-danger" })
                </div>

                <!-- Photo Field -->
                <div class="exam-form-group exam-col-span-2">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Photo)
                    </label>
                    <input type="file" class="exam-form-control" id="imageUpload" name="Stud_Photo" accept="image/*">
                    @Html.ValidationMessageFor(model => model.Stud_Photo, "", new { @class = "text-danger" })
                    <div class="exam-mt-3">
                        <label class="exam-form-label">Image Preview</label>
                        <img id="imagePreview" src="#" alt="Image Preview" style="display:none; width: 150px; height: 150px; object-fit: cover; border-radius: 8px; border: 1px solid #d1d5db;">
                    </div>
                </div>

                <!-- Username Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_UserName)
                    </label>
                    @Html.TextBoxFor(model => model.Stud_UserName, new { @class = "exam-form-control" })
                    @Html.ValidationMessageFor(model => model.Stud_UserName, "", new { @class = "text-danger" })
                </div>

                <!-- Password Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Password)
                        <span class="required">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Stud_Password, new { type = "password", @class = "exam-form-control" })
                    @Html.ValidationMessageFor(model => model.Stud_Password, "", new { @class = "text-danger" })
                </div>

                <!-- Admission Date Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_AdmissionDate)
                    </label>
                    @Html.TextBoxFor(model => model.Stud_AdmissionDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "exam-form-control" })
                    @Html.ValidationMessageFor(model => model.Stud_AdmissionDate, "", new { @class = "text-danger" })
                </div>

                <!-- Group Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Group)
                        <span class="required">*</span>
                    </label>
                    @Html.DropDownListFor(model => model.Stud_Group, new SelectList(ViewBag.GroupList, "Value", "Text"), "Select Group", new { @class = "exam-form-select" })
                    @Html.ValidationMessageFor(model => model.Stud_Group, "", new { @class = "text-danger" })
                </div>

                <!-- Class Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Class)
                    </label>
                    @if (ViewBag.Classlist != null)
                    {
                        @Html.DropDownListFor(model => model.Stud_Class, new SelectList(ViewBag.Classlist, "Value", "Text"), "Select Class", new { @class = "exam-form-select" })
                    }
                    else
                    {
                        <p>No classes available.</p>
                    }
                    @Html.ValidationMessageFor(model => model.Stud_Class, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        
        <!-- Form Actions -->
        <div class="exam-card-footer">
            <div class="exam-flex exam-justify-end exam-gap-4">
                <button type="submit" name="Action" value="Back To List" class="exam-btn exam-btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back To List
                </button>
                <button type="submit" name="Action" value="Cancel" class="exam-btn exam-btn-secondary">
                    <i class="fas fa-times"></i>
                    Cancel
                </button>
                <button type="submit" name="Action" value="Create" class="exam-btn exam-btn-primary">
                    <i class="fas fa-plus"></i>
                    Create Student
                </button>
            </div>
        </div>
    </div>
}

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

    <script>
        // Set today's date as the default value in the Stud_AdmissionDate input field
        window.onload = function () {
            const today = new Date().toISOString().split('T')[0]; // yyyy-MM-dd format
            document.getElementById('Stud_AdmissionDate').value = today;
        };

        // Display image preview when the file is selected
        document.getElementById('imageUpload').addEventListener('change', function (event) {
            const file = event.target.files[0]; // Get the selected file
            if (file) {
                const reader = new FileReader();

                // Event listener for when the file is read
                reader.onload = function (e) {
                    const preview = document.getElementById('imagePreview');
                    preview.src = e.target.result; // Set the image source to the file data URL
                    preview.style.display = 'block'; // Show the image preview
                };

                reader.readAsDataURL(file); // Read the file as a Data URL
            }
        });
    </script>
}
