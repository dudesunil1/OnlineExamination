@model OnlineExamination.Models.StudentDashboardCountData

@{
    ViewBag.Title = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Add custom styling for the dashboard -->
<style>
    .dashboard-container {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin: 20px;
    }

    .dashboard-box {
        width: 23%;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        transition: all 0.3s ease;
        color: white; /* White text for better contrast */
    }

        .dashboard-box:hover {
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.2);
            transform: scale(1.05); /* Slight zoom effect on hover */
        }

        .dashboard-box h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .dashboard-box p {
            font-size: 1.2rem;
            font-weight: bold;
        }

    /* Styling for each individual box color */
    .box-todays-tests {
        background-color: #4CAF50; /* Green for Today's Tests */
    }

    .box-attempted-tests {
        background-color: #2196F3; /* Blue for Attempted Tests */
    }

    .box-non-attempted-tests {
        background-color: #FF9800; /* Orange for Non-Attempted Tests */
    }

    .box-upcoming-tests {
        background-color: #FF5722; /* Red for Upcoming Tests */
    }

    /* Header Styling */
    .header-text {
        text-align: center;
        font-size: 2rem;
        margin-bottom: 40px;
    }
</style>

<h2 class="header-text">Student Dashboard</h2>

