@model IEnumerable<OnlineExamination.Models.SubjectsViewModel>

@{
    ViewBag.Title = "Subject Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Subject Management"},
            {"Url", Url.Action("Index", "SubjectMaster")},
            {"IsCurrent", true}
        }
    };
}

<!-- Professional Page Header -->
<div class="exam-page-header-professional">
    <div class="exam-header-content">
        <div class="exam-header-text">
            <h1 class="exam-page-title">Subject Management</h1>
            <p class="exam-page-description">Manage and organize examination subjects efficiently</p>
        </div>
        <div class="exam-header-actions">
            @Html.ActionLink("Create New Subject", "Create", null, new { @class = "exam-btn exam-btn-primary exam-btn-lg" })
        </div>
    </div>
</div>

<div class="exam-card">
    <div class="exam-card-content">
        <div class="exam-grid exam-grid-cols-1">
            <div class="exam-table-responsive">
                @if (Model == null || !Model.Any())
                {
                    <div class="exam-alert exam-alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        No Subjects Found
                    </div>
                }
                else
                {
                    <table class="exam-table" id="tblSuntech">
                        <thead class="exam-table-header">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.First().Sub_Id)</th>
                                <th>@Html.DisplayNameFor(model => model.First().Sub_Name)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody class="exam-table-body">
                            @foreach (var item in Model)
                            {
                                <tr class="exam-table-row">
                                    <td>@Html.DisplayFor(modelItem => item.Sub_Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Sub_Name)</td>
                                    <td>
                                        <div class="exam-flex exam-gap-2">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.Sub_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-warning" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

