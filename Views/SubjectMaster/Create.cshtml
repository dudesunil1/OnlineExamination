@model OnlineExamination.Models.SubjectsViewModel

@{
    ViewBag.Title = "Create Subject";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Subject Management"},
            {"Url", Url.Action("Index", "SubjectMaster")},
            {"IsCurrent", false}
        },
        new Dictionary<string, object>
        {
            {"Text", "Create Subject"},
            {"Url", Url.Action("Create", "SubjectMaster")},
            {"IsCurrent", true}
        }
    };
}

<!-- Page Header -->
<div class="exam-page-header">
    <h1 class="exam-page-title">Create Subject</h1>
    <p class="exam-page-description">Add new subject information and details.</p>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <!-- Subject Form Start -->
    <div class="exam-card">
        <div class="exam-card-header">
            <h2 class="exam-card-title">Subject Master</h2>
            <p class="exam-card-subtitle">Fields marked with <span class="exam-text-red-600">*</span> are mandatory.</p>
        </div>
        <div class="exam-card-content">
            <div class="exam-grid exam-grid-cols-1">
                <!-- Subject Name Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Sub_Name)
                        <span class="required">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Sub_Name, new { @class = "exam-form-control", placeholder = "Enter subject name" })
                    @Html.ValidationMessageFor(model => model.Sub_Name, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        
        <!-- Form Actions -->
        <div class="exam-card-footer">
            <div class="exam-flex exam-justify-end exam-gap-4">
                <button type="submit" name="Action" value="Back To List" class="exam-btn exam-btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back To List
                </button>
                <button type="submit" name="Action" value="Cancel" class="exam-btn exam-btn-secondary">
                    <i class="fas fa-times"></i>
                    Cancel
                </button>
                <button type="submit" name="Action" value="Create" class="exam-btn exam-btn-primary">
                    <i class="fas fa-plus"></i>
                    Create Subject
                </button>
            </div>
        </div>
    </div>

    
}
