@model OnlineExamination.Models.QuestionMasterViewModel

@{
    ViewBag.Title = "Question Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">Question Details</h2>

<div class="card shadow-lg border-light mb-4">
    <div class="card-body">
        <!-- Question details displayed in a row with labels and values -->
        <div class="row gy-4">
            <div class="col-12">
                <dl class="row">
                    <dt class="col-sm-4 text-end">
                       ID
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_Id)
                    </dd>

                    <dt class="col-sm-4 text-end">
                      Subject Name
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_SubName)
                    </dd>

                    <dt class="col-sm-4 text-end">
                        Class Name
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_ClassName)
                    </dd>

                    <dt class="col-sm-4 text-end">
                       Topic Name
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_TopName)
                    </dd>

                    <dt class="col-sm-4 text-end">
                       Publication Name
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_PubName)
                    </dd>

                    <dt class="col-sm-4 text-end">
                       Mark
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_Mark)
                    </dd>

                    <dt class="col-sm-4 text-end">
                       JEE Mark
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_JEEMark)
                    </dd>

                    <dt class="col-sm-4 text-end">
                       Negative Mark
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Ques_Negative)
                    </dd>

                    <dt class="col-sm-4 text-end">
                        Question
                    </dt>
                    <dd class="col-sm-8">
                        @Html.Raw(Model.Ques_Question)
                    </dd>

                    <dt class="col-sm-4 text-end">
                        Answer
                    </dt>
                    <dd class="col-sm-8">
                        @Html.Raw(Model.Ques_Answer)
                    </dd>

                    <dt class="col-sm-4 text-end">
                      OptionB
                    </dt>
                    <dd class="col-sm-8">
                        @Html.Raw(Model.Ques_OptionB)
                    </dd>

                    <dt class="col-sm-4 text-end">
                       OptionC
                    </dt>
                    <dd class="col-sm-8">
                        @Html.Raw(Model.Ques_OptionC)
                    </dd>

                    <dt class="col-sm-4 text-end">
                        Ques_OptionD
                    </dt>
                    <dd class="col-sm-8">
                        @Html.Raw(Model.Ques_OptionD)
                    </dd>

                    <dt class="col-sm-4 text-end">
                        Solution Details
                    </dt>
                    <dd class="col-sm-8">
                        @Html.Raw(Model.Ques_SolutionDetails)
                    </dd>
                </dl>
            </div>

            <div class="col-12 text-center mt-4">
                <p>
                    @Html.ActionLink("Edit", "Edit", new { id = Model.Ques_Id }, new { @class = "btn btn-warning btn-sm" }) |
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-sm" })
                </p>
            </div>
        </div>
    </div>
</div>

