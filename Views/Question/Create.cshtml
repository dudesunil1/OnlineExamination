 @model OnlineExamination.Models.QuestionMasterViewModel

@{
    ViewBag.Title = "Create Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create Question - Online Examination System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.tiny.cloud/1/@ViewData["ApiKey"]/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="https://cdn.jsdelivr.net/npm/es6-promise@4/dist/es6-promise.auto.min.js"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script src="https://unpkg.com/mathlive/dist/mathlive.min.js"></script>
</head>

@using (Html.BeginForm("Create", "Question", FormMethod.Post, new { id = "questionForm" }))
{
    @Html.AntiForgeryToken()

    <div class="container-fluid">
        <!-- Success/Error Messages -->
        @if (TempData["MessageModel"] != null)
        {
            var message = TempData["MessageModel"] as OnlineExamination.Models.MessageModel;
            if (message != null)
            {
                var alertClass = message.Type == "Success" ? "alert-success" : 
                                 message.Type == "Error" ? "alert-danger" : 
                                 message.Type == "Warning" ? "alert-warning" : "alert-info";
                <div class="alert @alertClass alert-dismissible fade show" role="alert">
                    <strong>@message.Type:</strong> @message.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        }

        <!-- Validation Summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Please fix the following errors:</strong>
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Breadcrumb -->
                                                                        <div class="breadcrumb-with-buttons mb-24 flex-between flex-wrap gap-8">
                                                                            <div class="breadcrumb mb-24">
                                                                                <ul class="flex-align gap-4">
                    <li><a href="@Url.Action("Index", "Home")" class="text-gray-200 fw-normal text-15 hover-text-main-600">Home</a></li>
                                                                                    <li><span class="text-gray-500 fw-normal d-flex"><i class="ph ph-caret-right"></i></span></li>
                                                                                    <li><span class="text-main-600 fw-normal text-15">Create Question</span></li>
                                                                                </ul>
                                                                            </div>
                                                                        </div>

        <!-- Main Card -->
                                                                        <div class="card">
                                                                            <div class="card-header border-bottom border-gray-100 flex-align gap-8">
                                                                                <h5 class="mb-0">Question Master</h5>
                                                                                <button type="button" class="text-main-600 text-md d-flex" data-bs-toggle="tooltip" data-bs-placement="top" title="Question Details">
                                                                                    <i class="ph-fill ph-question"></i>
                                                                                </button>
                                                                            </div>
            
                                                                            <div class="card-body">
                <!-- Basic Information Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Basic Information</h6>
                    </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_SubId" class="form-label fw-semibold">
                            Subject <span class="text-danger">*</span>
                                                                                                </label>
                                                                                                    @Html.DropDownListFor(
                                                                                                     model => model.Ques_SubId,
                                                                                                     new SelectList(ViewBag.SubjectList, "Value", "Text"),
                                                                                                     "Select Subject",
                            new { @class = "form-select", id = "Ques_SubId", required = "required" }
                        )
                        @Html.ValidationMessageFor(model => model.Ques_SubId, "", new { @class = "text-danger" })
                    </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_ClassId" class="form-label fw-semibold">
                            Class <span class="text-danger">*</span>
                                                                                                </label>
                                                                                                    @Html.DropDownListFor(
                                                                                                    model => model.Ques_ClassId,
                                                                                                     new SelectList(ViewBag.ClassList, "Value", "Text"),
                                                                                                     "Select Class",
                            new { @class = "form-select", id = "Ques_ClassId", required = "required" }
                                                                                                     )
                        @Html.ValidationMessageFor(model => model.Ques_ClassId, "", new { @class = "text-danger" })
                                                                                            </div>

                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_TopId" class="form-label fw-semibold">
                            Topic <span class="text-danger">*</span>
                                                                                                </label>
                                                                                                    @Html.DropDownListFor(
                                                                                                     model => model.Ques_TopId,
                                                                                                     new SelectList(ViewBag.TopicList, "Value", "Text"),
                                                                                                     "Select Topic",
                            new { @class = "form-select", id = "Ques_TopId", required = "required" }
                                                                                                     )
                        @Html.ValidationMessageFor(model => model.Ques_TopId, "", new { @class = "text-danger" })
                                                                                            </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_PubId" class="form-label fw-semibold">
                            Publication <span class="text-danger">*</span>
                                                                                                </label>
                                                                                                    @Html.DropDownListFor(
                                                                                                     model => model.Ques_PubId,
                                                                                                     new SelectList(ViewBag.PublicationList, "Value", "Text"),
                                                                                                     "Select Publication",
                            new { @class = "form-select", id = "Ques_PubId", required = "required" }
                                                                                                     )
                        @Html.ValidationMessageFor(model => model.Ques_PubId, "", new { @class = "text-danger" })
                                                                                                </div>
                                                                                            </div>

                <!-- Scoring Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Scoring</h6>
                    </div>
                    
                    <div class="col-md-4 col-sm-12">
                        <label for="Ques_Mark" class="form-label fw-semibold">
                            CET Marks <span class="text-danger">*</span>
                                                                                                </label>
                        @Html.TextBoxFor(model => model.Ques_Mark, new { 
                            type = "number", 
                            @class = "form-control", 
                            id = "Ques_Mark", 
                            required = "required",
                            min = "1",
                            step = "0.5"
                        })
                        @Html.ValidationMessageFor(model => model.Ques_Mark, "", new { @class = "text-danger" })
                                                                                                </div>
                    
                    <div class="col-md-4 col-sm-12">
                        <label for="Ques_JEEMark" class="form-label fw-semibold">
                            JEE Marks <span class="text-danger">*</span>
                        </label>
                        @Html.TextBoxFor(model => model.Ques_JEEMark, new { 
                            type = "number", 
                            @class = "form-control", 
                            id = "Ques_JEEMark", 
                            required = "required",
                            min = "1",
                            step = "0.5"
                        })
                        @Html.ValidationMessageFor(model => model.Ques_JEEMark, "", new { @class = "text-danger" })
                                                                                            </div>
                    
                    <div class="col-md-4 col-sm-12">
                        <label for="Ques_Negative" class="form-label fw-semibold">
                            Negative Marks <span class="text-danger">*</span>
                                                                                                </label>
                        @Html.TextBoxFor(model => model.Ques_Negative, new { 
                            type = "number", 
                            @class = "form-control", 
                            id = "Ques_Negative", 
                            required = "required",
                            min = "0",
                            step = "0.25"
                        })
                        @Html.ValidationMessageFor(model => model.Ques_Negative, "", new { @class = "text-danger" })
                                                                                                </div>
                                                                                            </div>

                <!-- Question Content Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Question Content</h6>
                    </div>
                    
                    <div class="col-12">
                        <label for="Ques_Question" class="form-label fw-semibold">
                            Question <span class="text-danger">*</span>
                                                                                                </label>
                        <textarea id="Ques_Question" name="Ques_Question" class="form-control"></textarea>
                        @Html.ValidationMessageFor(model => model.Ques_Question, "", new { @class = "text-danger" })
                                                                                                </div>
                                                                                            </div>

                <!-- Answer Options Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Answer Options</h6>
                    </div>
                    
                    <div class="col-12">
                        <label for="Ques_Answer" class="form-label fw-semibold">
                            Correct Answer <span class="text-danger">*</span>
                        </label>
                        <textarea id="Ques_Answer" name="Ques_Answer" class="form-control"></textarea>
                        @Html.ValidationMessageFor(model => model.Ques_Answer, "", new { @class = "text-danger" })
                    </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_OptionB" class="form-label fw-semibold">Option A</label>
                        <textarea id="Ques_OptionB" name="Ques_OptionB" class="form-control"></textarea>
                                                                                            </div>

                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_OptionC" class="form-label fw-semibold">Option B</label>
                        <textarea id="Ques_OptionC" name="Ques_OptionC" class="form-control"></textarea>
                    </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_OptionD" class="form-label fw-semibold">Option C</label>
                        <textarea id="Ques_OptionD" name="Ques_OptionD" class="form-control"></textarea>
                                                                                                </div>
                                                                                            </div>

                <!-- Solution Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Solution Details</h6>
                    </div>
                    
                    <div class="col-12">
                        <label for="Ques_SolutionDetails" class="form-label fw-semibold">Answer Description</label>
                        <textarea id="Ques_SolutionDetails" name="Ques_SolutionDetails" class="form-control"></textarea>
                                                                                                </div>
                                                                                                </div>

                <!-- Action Buttons -->
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-2">
                            <input type="submit" name="Action" value="Back To List" class="btn btn-secondary" />
                            <input type="submit" name="Action" value="Cancel" class="btn btn-danger" />
                            <input type="submit" name="Action" value="Continue" class="btn btn-success" />
                            <button type="button" id="InActivateKey" class="btn btn-warning">Inactivate Key</button>
                                                                                                </div>
                                                                                                </div>
                                                                                                </div>

                                                                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
}

<!-- MathJax Configuration -->
<script type="text/x-mathjax-config">
    MathJax = {
        tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']],
            displayMath: [['$$', '$$'], ['\\[', '\\]']],
            processEscapes: true,
            processClass: 'tex2jax_process'
        },
        options: {
            skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre']
        }
    };
</script>

<script>
    $(document).ready(function () {
        // Initialize TinyMCE editors
        initializeTinyMCE();
        
        // Initialize dropdown functionality
        initializeDropdowns();
        
        // Initialize API key functionality
        initializeAPIKey();

        // Save TinyMCE content before form submit
        $('#questionForm').on('submit', function(e) {
            console.log('=== FORM SUBMIT DEBUG ===');
            
            // Trigger TinyMCE to save content back to textareas
            tinymce.triggerSave();
            console.log('✅ TinyMCE content saved');
            
            // Log form data
            var formData = {
                subject: $('#Ques_SubId').val(),
                class: $('#Ques_ClassId').val(),
                topic: $('#Ques_TopId').val(),
                publication: $('#Ques_PubId').val(),
                cetMarks: $('#Ques_Mark').val(),
                jeeMarks: $('#Ques_JEEMark').val(),
                negative: $('#Ques_Negative').val(),
                question: $('#Ques_Question').val(),
                answer: $('#Ques_Answer').val(),
                optionB: $('#Ques_OptionB').val(),
                optionC: $('#Ques_OptionC').val(),
                optionD: $('#Ques_OptionD').val()
            };
            
            console.log('Form Data:', formData);
            
            // Check for empty required fields
            if (!formData.subject || formData.subject == '0' || formData.subject == '') {
                alert('Please select a Subject!');
                return false;
            }
            if (!formData.class || formData.class == '0' || formData.class == '') {
                alert('Please select a Class!');
                return false;
            }
            if (!formData.topic || formData.topic == '0' || formData.topic == '') {
                alert('Please select a Topic!');
                return false;
            }
            if (!formData.publication || formData.publication == '0' || formData.publication == '') {
                alert('Please select a Publication!');
                return false;
            }
            if (!formData.question || formData.question.trim() == '') {
                alert('Please enter the Question!');
                return false;
            }
            if (!formData.answer || formData.answer.trim() == '') {
                alert('Please enter the Correct Answer!');
                return false;
            }
            
            console.log('✅ All validations passed');
            console.log('Action button:', $('input[type=submit][clicked=true]').val());
            
            return true; // Allow form submission
        });

        // Track which submit button was clicked
        $('input[type=submit]').on('click', function() {
            $('input[type=submit]').removeAttr('clicked');
            $(this).attr('clicked', 'true');
        });
    });

    function initializeTinyMCE() {
        const editorConfig = {
            height: 300,
            plugins: 'preview importcss searchreplace autolink directionality code visualblocks visualchars fullscreen image link media codesample table charmap pagebreak nonbreaking anchor insertdatetime advlist lists wordcount help quickbars emoticons',
            toolbar: 'undo redo | bold italic underline strikethrough | fontselect fontsizeselect formatselect | alignleft aligncenter alignright alignjustify | outdent indent | numlist bullist | forecolor backcolor removeformat | pagebreak | charmap emoticons | fullscreen preview | image media link anchor codesample | code | math',
            setup: function (editor) {
                // Add custom Math button
                editor.ui.registry.addButton('math', {
                    text: 'Math',
                    tooltip: 'Insert Math Equation',
                    onAction: function () {
                        showMathEditor(editor);
                    }
                });
            },
            content_style: 'body { font-family:Helvetica,Arial,sans-serif; font-size:14px }'
        };

        // Initialize all textarea editors
        tinymce.init({
            ...editorConfig,
            selector: '#Ques_Question'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_Answer'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_OptionB'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_OptionC'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_OptionD'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_SolutionDetails'
        });
    }

    function showMathEditor(editor) {
        const modal = document.createElement('div');
        modal.style.cssText = `
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #ffffff;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            z-index: 10000;
            width: 400px;
            border-radius: 8px;
        `;

        modal.innerHTML = `
            <h3 style="margin-top: 0;">Math Equation Editor</h3>
            <math-field id="math-editor" style="width: 100%; font-size: 1.2em; border: 1px solid #ccc; padding: 8px; border-radius: 4px;"></math-field>
            <div style="margin-top: 10px; text-align: right;">
                <button id="insert-math" style="background-color: #007BFF; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-right: 5px;">Insert</button>
                <button id="cancel-math" style="background-color: #ccc; color: black; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">Cancel</button>
                                                                            </div>
        `;

        document.body.appendChild(modal);

        document.getElementById('insert-math').onclick = function () {
            const mathField = document.getElementById('math-editor');
            const mathLatex = mathField.getValue();
            if (mathLatex) {
                editor.insertContent(`\\(${mathLatex}\\)`);
                if (typeof MathJax !== 'undefined' && MathJax.typesetPromise) {
                    MathJax.typesetPromise();
                }
            }
            document.body.removeChild(modal);
        };

        document.getElementById('cancel-math').onclick = function () {
            document.body.removeChild(modal);
        };
    }

    function initializeDropdowns() {
            function fetchTopics() {
                const subjectID = $("#Ques_SubId").val();
                const classID = $("#Ques_ClassId").val();
                const $topicsDropdown = $("#Ques_TopId");

                $topicsDropdown.empty();
                $topicsDropdown.append('<option value="">Select Topics</option>');

            if (subjectID > 0 && classID > 0) {
                    $.ajax({
                    url: '/Master/GetTopicsBySubjectIDAndClassID?SubjectID=' + subjectID + '&ClassID=' + classID,
                        type: 'GET',
                        dataType: 'json',
                        success: function (response) {
                            if (response && response.length > 0) {
                                response.forEach(function (topic) {
                                    $topicsDropdown.append(
                                        `<option value="${topic.Top_Id}">${topic.Top_Name}</option>`
                                    );
                                });
                            }
                        },
                        error: function (xhr, status, error) {
                        console.error("Error fetching topics:", error);
                        }
                    });
                }
            }

            $("#Ques_SubId").change(fetchTopics);
            $("#Ques_ClassId").change(fetchTopics);
        fetchTopics(); // Initial load
    }

    function initializeAPIKey() {
        var key = '@ViewData["ApiKey"]';

        $('#InActivateKey').click(function () {
            $.ajax({
                url: '@Url.Action("InActivateKey", "Question")',
                type: 'POST',
                data: { apiKey: key },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.reload();
                    }
                },
                error: function () {
                    alert("An error occurred.");
                }
            });
        });
    }
</script>