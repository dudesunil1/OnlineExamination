 @model OnlineExamination.Models.QuestionMasterViewModel

@{
    ViewBag.Title = "Create Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Question Management"},
            {"Url", Url.Action("Index", "Question")},
            {"IsCurrent", false}
        },
        new Dictionary<string, object>
        {
            {"Text", "Create Question"},
            {"Url", Url.Action("Create", "Question")},
            {"IsCurrent", true}
        }
    };
}

<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create Question - Online Examination System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.tiny.cloud/1/@ViewData["ApiKey"]/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script src="https://unpkg.com/mathlive/dist/mathlive.min.js"></script>
</head>

<!-- Professional Page Header -->
<div class="exam-page-header-professional">
    <div class="exam-header-content">
        <div class="exam-header-text">
            <h1 class="exam-page-title">Create Question</h1>
            <p class="exam-page-description">Add new question with options and correct answer details efficiently</p>
        </div>
        <div class="exam-header-actions">
            @Html.ActionLink("Back to Questions", "Index", null, new { @class = "exam-btn exam-btn-secondary exam-btn-lg" })
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <!-- Question Form Start -->
    <div class="exam-card">
        <div class="exam-card-header">
            <h2 class="exam-card-title">Question Master</h2>
            <p class="exam-card-subtitle">Fields marked with <span class="exam-text-red-600">*</span> are mandatory.</p>
        </div>
        <div class="exam-card-content">
            <!-- Basic Information Section -->
            <div class="exam-form-section">
                <h3 class="exam-form-section-title">Basic Information</h3>
                <div class="exam-grid exam-grid-cols-2">
                    <!-- Subject Field -->
                    <div class="exam-form-group">
                        <label class="exam-form-label">
                            Subject <span class="required">*</span>
                        </label>
                        @Html.DropDownListFor(
                            model => model.Ques_SubId,
                            new SelectList(ViewBag.SubjectList, "Value", "Text"),
                            "Select Subject",
                            new { @class = "exam-form-select", id = "Ques_SubId", required = "required" }
                        )
                        @Html.ValidationMessageFor(model => model.Ques_SubId, "", new { @class = "text-danger" })
                    </div>
                    
                    <!-- Class Field -->
                    <div class="exam-form-group">
                        <label class="exam-form-label">
                            Class <span class="required">*</span>
                        </label>
                        @Html.DropDownListFor(
                            model => model.Ques_ClassId,
                            new SelectList(ViewBag.ClassList, "Value", "Text"),
                            "Select Class",
                            new { @class = "exam-form-select", id = "Ques_ClassId", required = "required" }
                        )
                        @Html.ValidationMessageFor(model => model.Ques_ClassId, "", new { @class = "text-danger" })
                    </div>

                    <!-- Topic Field -->
                    <div class="exam-form-group">
                        <label class="exam-form-label">
                            Topic <span class="required">*</span>
                        </label>
                        @Html.DropDownListFor(
                            model => model.Ques_TopId,
                            new SelectList(ViewBag.TopicList, "Value", "Text"),
                            "Select Topic",
                            new { @class = "exam-form-select", id = "Ques_TopId", required = "required" }
                        )
                        @Html.ValidationMessageFor(model => model.Ques_TopId, "", new { @class = "text-danger" })
                    </div>
                    
                    <!-- Publication Field -->
                    <div class="exam-form-group">
                        <label class="exam-form-label">
                            Publication <span class="required">*</span>
                        </label>
                        @Html.DropDownListFor(
                            model => model.Ques_PubId,
                            new SelectList(ViewBag.PublicationList, "Value", "Text"),
                            "Select Publication",
                            new { @class = "exam-form-select", id = "Ques_PubId", required = "required" }
                        )
                        @Html.ValidationMessageFor(model => model.Ques_PubId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Scoring Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Scoring</h6>
                    </div>
                    
                    <div class="col-md-4 col-sm-12">
                        <label for="Ques_Mark" class="form-label fw-semibold">
                            CET Marks <span class="text-danger">*</span>
                                                                                                </label>
                        @Html.TextBoxFor(model => model.Ques_Mark, new { 
                            type = "number", 
                            @class = "form-control", 
                            id = "Ques_Mark", 
                            required = "required",
                            min = "1",
                            step = "0.5"
                        })
                        @Html.ValidationMessageFor(model => model.Ques_Mark, "", new { @class = "text-danger" })
                                                                                                </div>
                    
                    <div class="col-md-4 col-sm-12">
                        <label for="Ques_JEEMark" class="form-label fw-semibold">
                            JEE Marks <span class="text-danger">*</span>
                        </label>
                        @Html.TextBoxFor(model => model.Ques_JEEMark, new { 
                            type = "number", 
                            @class = "form-control", 
                            id = "Ques_JEEMark", 
                            required = "required",
                            min = "1",
                            step = "0.5"
                        })
                        @Html.ValidationMessageFor(model => model.Ques_JEEMark, "", new { @class = "text-danger" })
                                                                                            </div>
                    
                    <div class="col-md-4 col-sm-12">
                        <label for="Ques_Negative" class="form-label fw-semibold">
                            Negative Marks <span class="text-danger">*</span>
                                                                                                </label>
                        @Html.TextBoxFor(model => model.Ques_Negative, new { 
                            type = "number", 
                            @class = "form-control", 
                            id = "Ques_Negative", 
                            required = "required",
                            min = "0",
                            step = "0.25"
                        })
                        @Html.ValidationMessageFor(model => model.Ques_Negative, "", new { @class = "text-danger" })
                                                                                                </div>
                                                                                            </div>

                <!-- Question Content Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Question Content</h6>
                    </div>
                    
                    <div class="col-12">
                        <label for="Ques_Question" class="form-label fw-semibold">
                            Question <span class="text-danger">*</span>
                                                                                                </label>
                        <textarea id="Ques_Question" name="Ques_Question" class="form-control" required></textarea>
                        @Html.ValidationMessageFor(model => model.Ques_Question, "", new { @class = "text-danger" })
                                                                                                </div>
                                                                                            </div>

                <!-- Answer Options Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Answer Options</h6>
                    </div>
                    
                    <div class="col-12">
                        <label for="Ques_Answer" class="form-label fw-semibold">
                            Correct Answer <span class="text-danger">*</span>
                        </label>
                        <textarea id="Ques_Answer" name="Ques_Answer" class="form-control" required></textarea>
                        @Html.ValidationMessageFor(model => model.Ques_Answer, "", new { @class = "text-danger" })
                    </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_OptionB" class="form-label fw-semibold">Option A</label>
                        <textarea id="Ques_OptionB" name="Ques_OptionB" class="form-control"></textarea>
                                                                                            </div>

                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_OptionC" class="form-label fw-semibold">Option B</label>
                        <textarea id="Ques_OptionC" name="Ques_OptionC" class="form-control"></textarea>
                    </div>
                    
                    <div class="col-md-6 col-sm-12">
                        <label for="Ques_OptionD" class="form-label fw-semibold">Option C</label>
                        <textarea id="Ques_OptionD" name="Ques_OptionD" class="form-control"></textarea>
                                                                                                </div>
                                                                                            </div>

                <!-- Solution Section -->
                <div class="row gy-20 mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3">Solution Details</h6>
                    </div>
                    
                    <div class="col-12">
                        <label for="Ques_SolutionDetails" class="form-label fw-semibold">Answer Description</label>
                        <textarea id="Ques_SolutionDetails" name="Ques_SolutionDetails" class="form-control"></textarea>
                                                                                                </div>
                                                                                                </div>

                <!-- Action Buttons -->
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-2">
                            <input type="submit" name="Action" value="Back To List" class="btn btn-outline-secondary" />
                            <input type="submit" name="Action" value="Cancel" class="btn btn-outline-warning" />
                            <input type="submit" name="Action" value="Continue" class="btn btn-primary" />
                            <button type="button" id="InActivateKey" class="btn btn-danger">Inactivate Key</button>
                                                                                                </div>
                                                                                                </div>
                                                                                                </div>

                                                                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
}

<!-- MathJax Configuration -->
<script type="text/x-mathjax-config">
    MathJax = {
        tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']],
            displayMath: [['$$', '$$'], ['\\[', '\\]']],
            processEscapes: true,
            processClass: 'tex2jax_process'
        },
        options: {
            skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre']
        }
    };
</script>

<script>
    $(document).ready(function () {
        // Initialize TinyMCE editors
        initializeTinyMCE();
        
        // Initialize dropdown functionality
        initializeDropdowns();
        
        // Initialize API key functionality
        initializeAPIKey();
    });

    function initializeTinyMCE() {
        const editorConfig = {
            height: 300,
            plugins: 'print preview importcss searchreplace autolink directionality code visualblocks visualchars fullscreen image link media template codesample table charmap hr pagebreak nonbreaking anchor insertdatetime advlist lists wordcount textpattern help charmap quickbars emoticons',
            toolbar: 'undo redo | bold italic underline strikethrough | fontselect fontsizeselect formatselect | alignleft aligncenter alignright alignjustify | outdent indent | numlist bullist checklist | forecolor backcolor casechange removeformat | pagebreak | charmap emoticons | fullscreen preview save print | insertfile image media link anchor codesample | ltr rtl | math',
            setup: function (editor) {
                // Add custom Math button
                editor.ui.registry.addButton('math', {
                    text: 'Math',
                    tooltip: 'Insert Math Equation',
                    onAction: function () {
                        showMathEditor(editor);
                    }
                });
            },
            content_style: 'body { font-family:Helvetica,Arial,sans-serif; font-size:14px }'
        };

        // Initialize all textarea editors
        tinymce.init({
            ...editorConfig,
            selector: '#Ques_Question'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_Answer'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_OptionB'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_OptionC'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_OptionD'
        });

        tinymce.init({
            ...editorConfig,
            selector: '#Ques_SolutionDetails'
        });
    }

    function showMathEditor(editor) {
        const modal = document.createElement('div');
        modal.style.cssText = `
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #ffffff;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            z-index: 10000;
            width: 400px;
            border-radius: 8px;
        `;

        modal.innerHTML = `
            <h3 style="margin-top: 0;">Math Equation Editor</h3>
            <math-field id="math-editor" style="width: 100%; font-size: 1.2em; border: 1px solid #ccc; padding: 8px; border-radius: 4px;"></math-field>
            <div style="margin-top: 10px; text-align: right;">
                <button id="insert-math" style="background-color: #007BFF; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-right: 5px;">Insert</button>
                <button id="cancel-math" style="background-color: #ccc; color: black; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">Cancel</button>
                                                                            </div>
        `;

        document.body.appendChild(modal);

        document.getElementById('insert-math').onclick = function () {
            const mathField = document.getElementById('math-editor');
            const mathLatex = mathField.getValue();
            if (mathLatex) {
                editor.insertContent(`\\(${mathLatex}\\)`);
                if (typeof MathJax !== 'undefined' && MathJax.typesetPromise) {
                    MathJax.typesetPromise();
                }
            }
            document.body.removeChild(modal);
        };

        document.getElementById('cancel-math').onclick = function () {
            document.body.removeChild(modal);
        };
    }

    function initializeDropdowns() {
            function fetchTopics() {
                const subjectID = $("#Ques_SubId").val();
                const classID = $("#Ques_ClassId").val();
                const $topicsDropdown = $("#Ques_TopId");

                $topicsDropdown.empty();
                $topicsDropdown.append('<option value="">Select Topics</option>');

            if (subjectID > 0 && classID > 0) {
                    $.ajax({
                    url: '/Master/GetTopicsBySubjectIDAndClassID?SubjectID=' + subjectID + '&ClassID=' + classID,
                        type: 'GET',
                        contentType: 'json',
                        success: function (response) {
                            if (response && response.length > 0) {
                                response.forEach(function (topic) {
                                    $topicsDropdown.append(
                                        `<option value="${topic.Top_Id}">${topic.Top_Name}</option>`
                                    );
                                });
                            }
                        },
                        error: function (xhr, status, error) {
                        console.error("Error fetching topics:", error);
                        }
                    });
                }
            }

            $("#Ques_SubId").change(fetchTopics);
            $("#Ques_ClassId").change(fetchTopics);
        fetchTopics(); // Initial load
    }

    function initializeAPIKey() {
        var key = '@ViewData["ApiKey"]';

        $('#InActivateKey').click(function () {
            $.ajax({
                url: '@Url.Action("InActivateKey", "Question")',
                type: 'POST',
                data: { apiKey: key },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.reload();
                    }
                },
                error: function () {
                    alert("An error occurred.");
                }
            });
        });
    }
</script>
 

                                                                       

                                                                     






