@model IEnumerable<OnlineExamination.Models.QuestionMasterViewModel>

@{
    ViewBag.Title = "Question Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Question Management"},
            {"Url", Url.Action("Index", "Question")},
            {"IsCurrent", true}
        }
    };
}
<script type="text/javascript" async
        src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js?config=TeX-MML-AM_CHTML"></script>

<!-- Professional Page Header -->
<div class="exam-page-header-professional">
    <div class="exam-header-content">
        <div class="exam-header-text">
            <h1 class="exam-page-title">Question Management</h1>
            <p class="exam-page-description">Manage and organize examination questions efficiently</p>
        </div>
        <div class="exam-header-actions">
            @Html.ActionLink("Create New Question", "Create", null, new { @class = "exam-btn exam-btn-primary exam-btn-lg" })
        </div>
    </div>
</div>

<div class="exam-card">

    <div class="exam-card-content">
        <div class="exam-grid exam-grid-cols-1">
            <div class="exam-table-responsive">
                @if (Model == null || !Model.Any())
                {
                    <div class="exam-alert exam-alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        No Questions Found
                    </div>
                }
                else
                {
                    <table class="exam-table">
                        <thead class="exam-table-header">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Ques_Id)</th>
                                <th>@Html.DisplayNameFor(model => model.Ques_Question)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody class="exam-table-body">
                            @foreach (var item in Model)
                            {
                                <tr class="exam-table-row">
                                    <td>@Html.DisplayFor(modelItem => item.Ques_Id)</td>
                                    <td>@Html.Raw(item.Ques_Question)</td>
                                    <td>
                                        <div class="exam-flex exam-gap-2">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.Ques_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-warning" }) 
                                            @Html.ActionLink("Details", "Details", new { id = item.Ques_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-info" }) 
                                            @*@Html.ActionLink("Delete", "Delete", new { id = item.Ques_Id }, new { @class = "exam-btn exam-btn-sm exam-btn-danger" })*@
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>



<style>

    .card-body {
        padding: 0;
    }

    table {
        width: 100%; /* Ensure the table takes the full available width */
        table-layout: fixed; /* Ensures columns are evenly spaced */
        margin: 0 auto; /* Center table in the page */
        border-collapse: collapse;
    }

    th, td {
        padding: 8px;
        text-align: center;
        vertical-align: middle;
        font-size: 14px;
        white-space: nowrap; /* Prevent text wrapping */
        overflow: hidden; /* Hide overflowed text */
        text-overflow: ellipsis; /* Adds ellipsis for overflowed text */
    }

    th {
        background-color: #f8f9fa;
        font-weight: bold;
    }

    td {
        background-color: #ffffff;
    }

    .btn {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .btn-warning {
        background-color: #ffc107;
        color: white;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .btn-info {
        background-color: #17a2b8;
        color: white;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }
</style>
