@model IEnumerable<OnlineExamination.Models.QuestionMasterViewModel>

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript" async
        src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js?config=TeX-MML-AM_CHTML"></script>

<div class="breadcrumb-with-buttons mb-4 flex-between flex-wrap gap-8">
    <!-- Breadcrumb Start -->
    <div class="breadcrumb mb-4">
        <ul class="flex-align gap-4">
            <li><a href="index.html" class="text-gray-200 fw-normal text-15 hover:text-primary">Home</a></li>
            <li><span class="text-gray-500 fw-normal d-flex"><i class="ph ph-caret-right"></i></span></li>
            <li><span class="text-primary-600 fw-normal text-15">Create Question</span></li>
        </ul>
    </div>
    <!-- Breadcrumb End -->
</div>

<div class="card shadow-lg border-light mb-4">
    <div class="card-header border-bottom border-gray-100 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Question Master</h5>
        <div>
            <button type="button" class="text-primary-600 text-md d-flex" data-bs-toggle="tooltip" data-bs-placement="top" title="Course Details">
                <i class="ph ph-fill ph-question"></i>
            </button>
            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary rounded-pill py-2" })
        </div>
    </div>

    <div class="card-body">
        <!-- Table to display questions -->
        <table class="table table-bordered table-sm text-center">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Ques_Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Ques_Question)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Ques_Id)</td>
                        <td>@Html.Raw(item.Ques_Question)</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.Ques_Id }, new { @class = "btn btn-warning btn-sm" }) |
                            @Html.ActionLink("Details", "Details", new { id = item.Ques_Id }, new { @class = "btn btn-info btn-sm" }) |
                            @*@Html.ActionLink("Delete", "Delete", new { id = item.Ques_Id }, new { @class = "btn btn-danger btn-sm" })*@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Initialize DataTable (optional)
    new DataTable('.table', {
        searching: false,
        lengthChange: false,
        info: false,  // Hide bottom left text (Showing 1 to 10 of 12 entries)
        paging: false, // Disable pagination
        columnDefs: [
            { "orderable": false, "targets": [2] } // Disable sorting on Action column
        ]
    });
</script>

<style>
    .breadcrumb-with-buttons {
        padding: 15px 0;
    }

    .breadcrumb a {
        text-decoration: none;
        color: #6c757d;
    }

        .breadcrumb a:hover {
            color: #007bff;
        }

    .card-body {
        padding: 0;
    }

    table {
        width: 100%; /* Ensure the table takes the full available width */
        table-layout: fixed; /* Ensures columns are evenly spaced */
        margin: 0 auto; /* Center table in the page */
        border-collapse: collapse;
    }

    th, td {
        padding: 8px;
        text-align: center;
        vertical-align: middle;
        font-size: 14px;
        white-space: nowrap; /* Prevent text wrapping */
        overflow: hidden; /* Hide overflowed text */
        text-overflow: ellipsis; /* Adds ellipsis for overflowed text */
    }

    th {
        background-color: #f8f9fa;
        font-weight: bold;
    }

    td {
        background-color: #ffffff;
    }

    .btn {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .btn-warning {
        background-color: #ffc107;
        color: white;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .btn-info {
        background-color: #17a2b8;
        color: white;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }
</style>
