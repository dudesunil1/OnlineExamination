@model OnlineExamination.Models.QuestionMasterViewModel

@{
    ViewBag.Title = "Edit Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Question Management"},
            {"Url", Url.Action("Index", "Question")},
            {"IsCurrent", false}
        },
        new Dictionary<string, object>
        {
            {"Text", "Edit Question"},
            {"Url", Url.Action("Edit", "Question")},
            {"IsCurrent", true}
        }
    };
}
<script src="https://cdn.tiny.cloud/1/@ViewData["ApiKey"]/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
<link rel="stylesheet" href="https://unpkg.com/mathlive/dist/mathlive.min.css">
<script src="https://unpkg.com/mathlive/dist/mathlive.min.js"></script>

<!-- Page Header -->
<div class="exam-page-header">
    <h1 class="exam-page-title">Edit Question</h1>
    <p class="exam-page-description">Update question information and answer details.</p>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <!-- Question Form Start -->
    <div class="exam-card">
        <div class="exam-card-header">
            <h2 class="exam-card-title">Question Master</h2>
            <p class="exam-card-subtitle">Fields marked with <span class="exam-text-red-600">*</span> are mandatory.</p>
        </div>
        <div class="exam-card-content">

            <div class="exam-grid exam-grid-cols-2">
                <!-- Subject Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        Subject <span class="required">*</span>
                    </label>
                    @Html.DropDownListFor(
                        model => model.Ques_SubId,
                        new SelectList(ViewBag.SubjectList, "Value", "Text"),
                        "Select Subject",
                        new { @class = "exam-form-select", id = "Ques_SubId" }
                    )
                    @Html.ValidationMessageFor(model => model.Ques_SubId, "", new { @class = "text-danger" })
                </div>

                <!-- Class Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        Class <span class="required">*</span>
                    </label>
                    @Html.DropDownListFor(
                        model => model.Ques_ClassId,
                        new SelectList(ViewBag.ClassList, "Value", "Text"),
                        "Select Class",
                        new { @class = "exam-form-select", id = "Ques_ClassId" }
                    )
                    @Html.ValidationMessageFor(model => model.Ques_ClassId, "", new { @class = "text-danger" })
                </div>

                <!-- Topic Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        Topic <span class="required">*</span>
                    </label>
                    @Html.HiddenFor(model => model.Ques_TopId)
                    @Html.DropDownListFor(
                        model => model.Ques_TopId,
                        new SelectList(ViewBag.TopicList, "Value", "Text"),
                        "Select Topic",
                        new { @class = "exam-form-select", id = "Ques_TopId" }
                    )
                    @Html.ValidationMessageFor(model => model.Ques_TopId, "", new { @class = "text-danger" })
                </div>

                <!-- Publication Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        Publication <span class="required">*</span>
                    </label>
                    @Html.DropDownListFor(
                        model => model.Ques_PubId,
                        new SelectList(ViewBag.PublicationList, "Value", "Text"),
                        "Select Publication",
                        new { @class = "exam-form-select", id = "Ques_PubId" }
                    )
                    @Html.ValidationMessageFor(model => model.Ques_PubId, "", new { @class = "text-danger" })
                </div>
            </div>
                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                CET Marks
                                <span class="text-13 text-gray-400 fw-medium">(Required)</span>
                            </label>
                            <div class="position-relative">
                                @Html.TextBoxFor(model => model.Ques_Mark, new { type = "number", @class = "text-counter placeholder-13 form-control py-11 pe-76", id = "Ques_Mark" })
                            </div>

                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                JEE Marks
                                <span class="text-13 text-gray-400 fw-medium">(Required)</span>
                            </label>
                            <div class="position-relative">

                                @Html.TextBoxFor(model => model.Ques_JEEMark, new { type = "number", @class = "text-counter placeholder-13 form-control py-11 pe-76", id = "Ques_JEEMark" })
                            </div>

                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Negative Marks
                                <span class="text-13 text-gray-400 fw-medium">(Required)</span>
                            </label>
                            <div class="position-relative">
                                @Html.TextBoxFor(model => model.Ques_Negative, new { type = "number", @class = "text-counter placeholder-13 form-control py-11 pe-76", id = "Ques_Negative" })
                            </div>


                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Enter Question
                                <span class="text-13 text-gray-400 fw-medium">(Required)</span>
                            </label>
                            <div class="position-relative">
                                @Html.TextAreaFor(model => model.Ques_Question, new { @id = "Ques_Question", @class = "form-control" })
                            </div>

                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Answer
                            </label>
                            <div class="position-relative">
                                @Html.TextAreaFor(model => model.Ques_Answer, new { @id = "Ques_Answer", @class = "form-control" })
                            </div>
                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Option 1
                            </label>
                            <div class="position-relative">
                                @Html.TextAreaFor(model => model.Ques_OptionB, new { @id = "Ques_OptionB", @class = "form-control" })
                            </div>
                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Option 2
                            </label>
                            <div class="position-relative">
                                @Html.TextAreaFor(model => model.Ques_OptionC, new { @id = "Ques_OptionC", @class = "form-control" })
                            </div>
                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Option 3
                            </label>
                            <div class="position-relative">
                                @Html.TextAreaFor(model => model.Ques_OptionD, new { @id = "Ques_OptionD", @class = "form-control" })
                            </div>
                            <label for="courseTitle" class="h5 mb-8 fw-semibold font-heading">
                                Answer Description
                            </label>
                            <div class="position-relative">
                                @Html.TextAreaFor(model => model.Ques_SolutionDetails, new { @id = "Ques_SolutionDetails", @class = "form-control" })
                            </div>


                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="flex-align justify-content-end gap-8">

                    <input type="submit" name="Action" value="Back To List" class="btn btn-outline-main rounded-pill py-9" />
                    <input type="submit" name="Action" value="Save" class="btn btn-main rounded-pill py-9" />
                    <button type="button" Id="InActivateKey" class="btn btn-main rounded-pill py-9">Inactivate Key</button>

                </div>
            </div>
            @Html.HiddenFor(model => model.Ques_Id)




        </div>
    </div>
    <script src="~/Content/assets/js/jquery-3.7.1.min.js"></script>
    <script>


        $(document).ready(function () {
            loadTopics(@Model.Ques_TopId);
            $("#Ques_SubId, #Ques_ClassId").change(function () {
                loadTopics(0);
            });

            $("#Ques_TopId").val(@Model.Ques_TopId);
        })

        function loadTopics(topicid) {
            const subjectID = $("#Ques_SubId").val();
            const classID = $("#Ques_ClassId").val();

            console.log("SubjectID=" + subjectID);
            console.log("Ques_ClassId=" + classID);


            const $topicsDropdown = $("#Ques_TopId");

            // Clear the sub-subject dropdown


            if (subjectID > 0 && classID > 0) {
                $topicsDropdown.empty();
                $topicsDropdown.append('<option value="">Select Topics</option>');
                // Make an AJAX request to fetch sub-subjects
                $.ajax({
                    url: '/Master/GetTopicsBySubjectIDAndClassID?SubjectID=' + subjectID + '&ClassID=' + classID, // Replace with the actual controller path
                    type: 'GET',
                    contentType: 'json',
                    success: function (response) {
                        console.log("success");
                        console.log(response);
                        if (response && response.length > 0) {
                            // Populate the sub-subject dropdown with the response data
                            response.forEach(function (topic) {
                                $topicsDropdown.append(
                                    `<option value="${topic.Top_Id}">${topic.Top_Name}</option>`
                                );
                            });



                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching sub-subjects:", error);
                    }
                });
            }
        }

    $(document).ready(function () {
        var key = '@ViewData["ApiKey"]';

        $('#InActivateKey').click(function () {
            $.ajax({
                url: '@Url.Action("InActivateKey", "Question")', // Controller/Action
                type: 'POST',
                data: { apiKey: key },
                success: function (response) {
                    if (response.success) {
                        alert(response.message); window.location.reload();
                    }
                },
                error: function () {
                    alert("An error occurred.");
                }
            });
        });
    });
    </script>
