<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Online Examination System</title>
    
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons (Alternative to Phosphor) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- Exam App Theme CSS -->
    <link rel="stylesheet" href="~/Content/assets/css/exam-app-theme.css">
    
    <style>
        /* Additional custom styles */
        .exam-sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            display: none;
        }
        
        .exam-sidebar-overlay.show {
            display: block;
        }
        
        .exam-dropdown {
            position: relative;
        }
        
        .exam-dropdown-menu {
            position: absolute;
            top: 100%;
            right: 0;
            background: var(--white);
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            min-width: 280px;
            z-index: 1000;
            display: none;
            padding: var(--space-2);
        }
        
        .exam-dropdown.open .exam-dropdown-menu {
            display: block;
        }
        
        .exam-dropdown-header {
            padding: var(--space-3);
            font-weight: 600;
            color: var(--gray-900);
            border-bottom: 1px solid var(--gray-200);
            margin-bottom: var(--space-2);
        }
        
        .exam-dropdown-item {
            padding: var(--space-3);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: var(--transition);
        }
        
        .exam-dropdown-item:hover {
            background: var(--gray-50);
        }
        
        .exam-dropdown-item-title {
            font-weight: 500;
            color: var(--gray-900);
            font-size: 0.875rem;
        }
        
        .exam-dropdown-item-meta {
            color: var(--gray-500);
            font-size: 0.75rem;
            margin-top: var(--space-1);
        }
        
        .exam-notification {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 10000;
            transform: translateX(400px);
            transition: transform 0.3s ease;
        }
        
        .exam-notification.show {
            transform: translateX(0);
        }
        
        .exam-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid transparent;
            border-top: 2px solid currentColor;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }
        
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .exam-field-error {
            color: var(--error);
            font-size: 0.75rem;
            margin-top: var(--space-1);
            display: flex;
            align-items: center;
            gap: var(--space-1);
        }
        
        .exam-field-success {
            color: var(--success);
        }
        
        .exam-field-valid {
            border-color: var(--success);
        }
        
        .exam-field-invalid {
            border-color: var(--error);
        }
    </style>
</head>
<body>
    <!-- Preloader -->
    <div class="preloader">
        <div class="loader"></div>
    </div>

    <!-- Sidebar Overlay -->
    <div class="exam-sidebar-overlay"></div>

    <!-- Top Navigation Bar -->
    <div class="exam-top-navbar">
        <div class="exam-navbar-left">
            <!-- Toggle Button -->
            <button type="button" class="exam-sidebar-toggle exam-btn exam-btn-secondary">
                <i class="fas fa-bars"></i>
            </button>
            
            <!-- Logo -->
            <a href="@Url.Action("Index", "Home")" class="exam-logo">
                <div class="exam-logo-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <span>Online Examination</span>
            </a>
            
            <!-- Breadcrumb Navigation -->
            <div class="exam-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Home</a>
                @if (ViewBag.BreadcrumbItems != null)
                {
                    var breadcrumbItems = ViewBag.BreadcrumbItems as List<object>;
                    foreach (var item in breadcrumbItems)
                    {
                        <span class="exam-breadcrumb-separator">/</span>
                        var itemDict = item as Dictionary<string, object>;
                        var text = itemDict["Text"].ToString();
                        var url = itemDict["Url"].ToString();
                        var isCurrent = (bool)itemDict["IsCurrent"];
                        
                        if (isCurrent)
                        {
                            <span class="exam-breadcrumb-current">@text</span>
                        }
                        else
                        {
                            <a href="@url">@text</a>
                        }
                    }
                }
                else if (!string.IsNullOrEmpty(ViewBag.Title))
                {
                    <span class="exam-breadcrumb-separator">/</span>
                    <span class="exam-breadcrumb-current">@ViewBag.Title</span>
                }
            </div>
            
        </div>

        <div class="exam-navbar-right">
            <!-- User Info -->
            <div class="exam-user-info">
                <div class="exam-user-avatar">
                    @if (ViewBag.UserRole == "ADMIN")
                    {
                        <span>A</span>
                    }
                    else
                    {
                        <span>S</span>
                    }
                </div>
                <div class="exam-user-details">
                    <div class="exam-user-name">Welcome, @(ViewBag.UserRole == "ADMIN" ? "Admin" : "Student")</div>
                    <div class="exam-user-role">@ViewBag.UserRole</div>
                </div>
            </div>
            
            <!-- Notification Dropdown -->
            <div class="exam-dropdown">
                <button class="exam-dropdown-trigger exam-btn exam-btn-secondary" type="button">
                    <i class="fas fa-bell"></i>
                    <span class="exam-nav-badge">3</span>
                </button>
                <div class="exam-dropdown-menu">
                    <div class="exam-dropdown-header">Notifications</div>
                    <div class="exam-dropdown-item">
                        <div class="exam-dropdown-item-title">New Exam Available</div>
                        <div class="exam-dropdown-item-meta">2 minutes ago</div>
                    </div>
                    <div class="exam-dropdown-item">
                        <div class="exam-dropdown-item-title">Result Published</div>
                        <div class="exam-dropdown-item-meta">1 hour ago</div>
                    </div>
                    <div class="exam-dropdown-item">
                        <div class="exam-dropdown-item-title">Profile Update</div>
                        <div class="exam-dropdown-item-meta">3 hours ago</div>
                    </div>
                </div>
            </div>
            
            <!-- Logout Button -->
            <a href="@Url.Action("Logout", "Home")" class="exam-btn exam-btn-danger">
                <i class="fas fa-sign-out-alt"></i>
                Logout
            </a>
        </div>
    </div>

    <!-- Sidebar -->
    <aside class="exam-sidebar">

        <nav class="exam-sidebar-nav">
            @if (ViewBag.UserRole == "ADMIN")
            {
                <ul class="exam-sidebar-menu">
                    <li class="exam-menu-item has-dropdown">
                        <a href="#" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-users"></i>
                            </span>
                            <span>Student Management</span>
                        </a>
                        <ul class="sidebar-submenu">
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Index", "StudentMaster")" class="sidebar-submenu__link">Student List</a>
                            </li>
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Create", "StudentMaster")" class="sidebar-submenu__link">Add Student</a>
                            </li>
                        </ul>
                    </li>
                    
                    <li class="exam-menu-item has-dropdown">
                        <a href="#" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-question-circle"></i>
                            </span>
                            <span>Question Management</span>
                        </a>
                        <ul class="sidebar-submenu">
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Index", "Question")" class="sidebar-submenu__link">Question List</a>
                            </li>
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Create", "Question")" class="sidebar-submenu__link">Add Question</a>
                            </li>
                        </ul>
                    </li>
                    
                    <li class="exam-menu-item has-dropdown">
                        <a href="#" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-clipboard-list"></i>
                            </span>
                            <span>Test Management</span>
                        </a>
                        <ul class="sidebar-submenu">
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Index", "TestMaster")" class="sidebar-submenu__link">Test List</a>
                            </li>
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Create", "TestMaster")" class="sidebar-submenu__link">Create Test</a>
                            </li>
                        </ul>
                    </li>
                    
                    <li class="exam-menu-item has-dropdown">
                        <a href="#" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-graduation-cap"></i>
                            </span>
                            <span>Subject Master</span>
                        </a>
                        <ul class="sidebar-submenu">
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Index", "SubjectMaster")" class="sidebar-submenu__link">Subject List</a>
                            </li>
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Create", "SubjectMaster")" class="sidebar-submenu__link">Add Subject</a>
                            </li>
                        </ul>
                    </li>
                    
                    <li class="exam-menu-item has-dropdown">
                        <a href="#" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-chart-line"></i>
                            </span>
                            <span>Reports</span>
                        </a>
                        <ul class="sidebar-submenu">
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("List", "TestResult")" class="sidebar-submenu__link">Results & Reports</a>
                            </li>
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Index", "Home")" class="sidebar-submenu__link">Analytics</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            }
            else if (ViewBag.UserRole == "STUDENT")
            {
                <ul class="exam-sidebar-menu">
                    <li class="exam-menu-item">
                        <a href="@Url.Action("Index", "Home")" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-home"></i>
                            </span>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    
                    <li class="exam-menu-item has-dropdown">
                        <a href="#" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-clipboard-list"></i>
                            </span>
                            <span>My Exams</span>
                        </a>
                        <ul class="sidebar-submenu">
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("TestList", "Student")" class="sidebar-submenu__link">Available Tests</a>
                            </li>
                            <li class="sidebar-submenu__item">
                                <a href="@Url.Action("Index", "Home")" class="sidebar-submenu__link">Test History</a>
                            </li>
                        </ul>
                    </li>
                    
                    <li class="exam-menu-item">
                        <a href="@Url.Action("Profile", "Student")" class="exam-menu-link">
                            <span class="icon">
                                <i class="fas fa-user-circle"></i>
                            </span>
                            <span>My Profile</span>
                        </a>
                    </li>
                </ul>
            }
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="exam-main-content">
        <div class="exam-content-wrapper">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="exam-footer">
        <div class="exam-flex exam-justify-between exam-items-center">
            <p class="exam-text-gray-500 exam-text-sm">&copy; 2024 Online Examination System. All rights reserved.</p>
            <div class="exam-flex exam-gap-4">
                <a href="#" class="exam-text-gray-500 exam-text-sm hover:exam-text-blue-600">Privacy Policy</a>
                <a href="#" class="exam-text-gray-500 exam-text-sm hover:exam-text-blue-600">Terms of Service</a>
                <a href="#" class="exam-text-gray-500 exam-text-sm hover:exam-text-blue-600">Support</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Exam App Theme JavaScript -->
    <script src="~/Scripts/exam-app-theme.js"></script>
    
    @RenderSection("scripts", required: false)
</body>
</html>