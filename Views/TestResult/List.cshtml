@model IEnumerable<OnlineExamination.Models.TestResultModel>

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="card">
    <div class="card-header border-bottom border-gray-100 flex-align gap-8">
        <h5 class="mb-0">Test Result</h5>
        

    
    </div>
    <div class="card-body">

        <div class="row gy-20">
            <div class="col-xxl-12 col-md-12 col-sm-12">
                <div class="row g-20">
                    <div class="col-sm-12">
                        @if (Model == null || !Model.Any())
                        {
                            <div class="alert alert-warning">
                                No Data Found
                            </div>
                        }
                        else
                        {
                            <table class="table table-striped table-hover text-center" id="tblSuntech">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Test ID</th>
                                        <th>Student ID</th>
                                        <th>Test Name</th>
                                        <th>Student Name</th>
                                        <th>Attempted</th>
                                        <th>Mark</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var result in Model)
                                    {
                                        <tr>
                                            <td>@result.TS_TestId</td>
                                            <td>@result.TS_StudId</td>
                                            <td>@result.TS_TestName</td>
                                            <td>@result.TS_StudName</td>
                                            <td>
                                                @if (result.TS_IsAttempted)
                                                {
                                                    @:Attempted
                                                }
                                                else
                                                {
                                                    @:Not Attempted
                                                }
                                            </td>
                                            <td>@result.TS_Mark</td>
                                            <td>
                                                <!-- Assuming you have a Details link or button to view more information -->
                                                <a href="@Url.Action("Details", "Test", new { id = result.TS_Id })" class="btn btn-info btn-sm">View Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>




