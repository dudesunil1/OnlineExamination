@model IEnumerable<OnlineExamination.Models.TestMasterModel>

@{
    ViewBag.Title = "Test Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Test Management"},
            {"Url", Url.Action("Index", "TestMaster")},
            {"IsCurrent", true}
        }
    };
}

<!-- Page Header -->
<div class="exam-page-header">
    <h1 class="exam-page-title">Test Management</h1>
    <p class="exam-page-description">Manage and organize examination tests for students.</p>
</div>

<!-- Action Buttons -->
<div class="exam-card exam-mb-6">
    <div class="exam-card-content">
        <div class="exam-flex exam-justify-between exam-items-center">
            <div class="exam-flex exam-gap-4">
                <a href="@Url.Action("Create", "TestMaster")" class="exam-btn exam-btn-primary">
                    <i class="fas fa-plus"></i>
                    Create New Test
                </a>
                <button type="button" class="exam-btn exam-btn-secondary" onclick="refreshTests()">
                    <i class="fas fa-sync-alt"></i>
                    Refresh
                </button>
            </div>
            
            <div class="exam-flex exam-gap-4 exam-items-center">
                <div class="exam-search-box">
                    <input type="text" id="testSearch" placeholder="Search tests..." class="exam-form-control">
                    <i class="fas fa-search exam-search-icon"></i>
                </div>
                <select id="statusFilter" class="exam-form-select exam-w-32">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="completed">Completed</option>
                    <option value="upcoming">Upcoming</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Tests Grid -->
<div class="exam-card">
    <div class="exam-card-header">
        <h2 class="exam-card-title">Tests List</h2>
        <p class="exam-card-subtitle">Manage your examination tests and assignments.</p>
    </div>
    
    <div class="exam-card-content">
        @if (Model != null && Model.Any())
        {
            <div class="exam-grid exam-grid-cols-1 exam-gap-4" id="testsContainer">
                @foreach (var test in Model)
                {
                    <div class="exam-test-card" data-test-id="@test.Test_Id">
                        <div class="exam-test-card-header">
                            <div class="exam-flex exam-justify-between exam-items-start">
                                <div>
                                    <h3 class="exam-test-name">@test.Test_Name</h3>
                                    <p class="exam-test-id">Test ID: #@test.Test_Id</p>
                                </div>
                                <div class="exam-test-status">
                                    @{
                                        var currentTime = DateTime.Now;
                                        var testStatus = "";
                                        var statusClass = "";
                                        
                                        if (currentTime < test.Test_StartTime)
                                        {
                                            testStatus = "Upcoming";
                                            statusClass = "exam-status-upcoming";
                                        }
                                        else if (currentTime >= test.Test_StartTime && currentTime <= test.Test_EndTime)
                                        {
                                            testStatus = "Active";
                                            statusClass = "exam-status-active";
                                        }
                                        else
                                        {
                                            testStatus = "Completed";
                                            statusClass = "exam-status-completed";
                                        }
                                    }
                                    <span class="exam-status-badge @statusClass">@testStatus</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="exam-test-card-content">
                            <div class="exam-grid exam-grid-cols-3 exam-gap-4">
                                <div class="exam-test-info">
                                    <div class="exam-test-info-label">Duration</div>
                                    <div class="exam-test-info-value">@test.Test_Duration minutes</div>
                                </div>
                                <div class="exam-test-info">
                                    <div class="exam-test-info-label">Total Marks</div>
                                    <div class="exam-test-info-value">@test.Test_Mark</div>
                                </div>
                                <div class="exam-test-info">
                                    <div class="exam-test-info-label">Test Type</div>
                                    <div class="exam-test-info-value">Type @test.Test_TypeId</div>
                                </div>
                            </div>
                            
                            <div class="exam-grid exam-grid-cols-2 exam-gap-4 exam-mt-4">
                                <div class="exam-test-info">
                                    <div class="exam-test-info-label">Start Time</div>
                                    <div class="exam-test-info-value">@test.Test_StartTime.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="exam-test-info">
                                    <div class="exam-test-info-label">End Time</div>
                                    <div class="exam-test-info-value">@test.Test_EndTime.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="exam-test-card-footer">
                            <div class="exam-flex exam-gap-3">
                                <button type="button" class="exam-btn exam-btn-secondary exam-btn-sm" onclick="viewTestDetails(@test.Test_Id)">
                                    <i class="fas fa-eye"></i>
                                    View Details
                                </button>
                                <button type="button" class="exam-btn exam-btn-primary exam-btn-sm" onclick="editTest(@test.Test_Id)">
                                    <i class="fas fa-edit"></i>
                                    Edit
                                </button>
                                <button type="button" class="exam-btn exam-btn-success exam-btn-sm" onclick="assignTest(@test.Test_Id)">
                                    <i class="fas fa-user-plus"></i>
                                    Assign
                                </button>
                                <button type="button" class="exam-btn exam-btn-danger exam-btn-sm" onclick="deleteTest(@test.Test_Id)">
                                    <i class="fas fa-trash"></i>
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="exam-empty-state">
                <div class="exam-empty-state-icon">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <h3 class="exam-empty-state-title">No Tests Found</h3>
                <p class="exam-empty-state-description">
                    You haven't created any tests yet. Start by creating your first test.
                </p>
                <a href="@Url.Action("Create", "TestMaster")" class="exam-btn exam-btn-primary">
                    <i class="fas fa-plus"></i>
                    Create Your First Test
                </a>
            </div>
        }
    </div>
</div>

<!-- Test Details Modal -->
<div id="testDetailsModal" class="exam-modal">
    <div class="exam-modal-content">
        <div class="exam-modal-header">
            <h3 class="exam-modal-title">Test Details</h3>
            <button type="button" class="exam-modal-close" onclick="closeTestDetailsModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="exam-modal-body" id="testDetailsContent">
            <!-- Test details will be loaded here -->
        </div>
        <div class="exam-modal-footer">
            <button type="button" class="exam-btn exam-btn-secondary" onclick="closeTestDetailsModal()">
                Close
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            initializeTestManagement();
        });

        function initializeTestManagement() {
            // Initialize search functionality
            const searchInput = document.getElementById('testSearch');
            const statusFilter = document.getElementById('statusFilter');
            
            if (searchInput) {
                searchInput.addEventListener('input', filterTests);
            }
            
            if (statusFilter) {
                statusFilter.addEventListener('change', filterTests);
            }
        }

        function filterTests() {
            const searchTerm = document.getElementById('testSearch').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const testCards = document.querySelectorAll('.exam-test-card');
            
            testCards.forEach(card => {
                const testName = card.querySelector('.exam-test-name').textContent.toLowerCase();
                const statusBadge = card.querySelector('.exam-status-badge');
                const status = statusBadge ? statusBadge.textContent.toLowerCase() : '';
                
                let matchesSearch = testName.includes(searchTerm);
                let matchesStatus = !statusFilter || status.includes(statusFilter);
                
                if (matchesSearch && matchesStatus) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function refreshTests() {
            location.reload();
        }

        function viewTestDetails(testId) {
            // Load test details via AJAX
            const modal = document.getElementById('testDetailsModal');
            const content = document.getElementById('testDetailsContent');
            
            content.innerHTML = '<div class="exam-spinner"></div> Loading test details...';
            modal.style.display = 'block';
            
            // Simulate loading test details
            setTimeout(() => {
                content.innerHTML = `
                    <div class="exam-grid exam-grid-cols-2 exam-gap-4">
                        <div class="exam-form-group">
                            <label class="exam-form-label">Test Name</label>
                            <div class="exam-form-value">Sample Test ${testId}</div>
                        </div>
                        <div class="exam-form-group">
                            <label class="exam-form-label">Test ID</label>
                            <div class="exam-form-value">#${testId}</div>
                        </div>
                        <div class="exam-form-group">
                            <label class="exam-form-label">Duration</label>
                            <div class="exam-form-value">60 minutes</div>
                        </div>
                        <div class="exam-form-group">
                            <label class="exam-form-label">Total Marks</label>
                            <div class="exam-form-value">100</div>
                        </div>
                    </div>
                `;
            }, 1000);
        }

        function closeTestDetailsModal() {
            document.getElementById('testDetailsModal').style.display = 'none';
        }

        function editTest(testId) {
            // Redirect to edit page
            window.location.href = '@Url.Action("Create", "TestMaster")' + '?id=' + testId;
        }

        function assignTest(testId) {
            // Show assignment modal or redirect to assignment page
            alert('Assign test functionality will be implemented here for Test ID: ' + testId);
        }

        function deleteTest(testId) {
            if (confirm('Are you sure you want to delete this test? This action cannot be undone.')) {
                // Implement delete functionality
                alert('Delete test functionality will be implemented here for Test ID: ' + testId);
            }
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('testDetailsModal');
            if (event.target === modal) {
                closeTestDetailsModal();
            }
        }
    </script>
}
