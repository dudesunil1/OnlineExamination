@model OnlineExamination.Models.StudentMasterModel

@{
    ViewBag.Title = "Student Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set breadcrumb items
    ViewBag.BreadcrumbItems = new List<object>
    {
        new Dictionary<string, object>
        {
            {"Text", "Student Dashboard"},
            {"Url", Url.Action("Index", "Student")},
            {"IsCurrent", false}
        },
        new Dictionary<string, object>
        {
            {"Text", "Student Profile"},
            {"Url", Url.Action("Profile", "Student")},
            {"IsCurrent", true}
        }
    };
}

<!-- Professional Page Header -->
<div class="exam-page-header-professional">
    <div class="exam-header-content">
        <div class="exam-header-text">
            <h1 class="exam-page-title">My Profile</h1>
            <p class="exam-page-description">View and manage your personal information and academic details</p>
        </div>
        <div class="exam-header-actions">
            <div class="exam-flex exam-gap-3">
                @Html.ActionLink("Edit Profile", "Edit", "StudentMaster", new { id = Model.Stud_Id }, new { @class = "exam-btn exam-btn-primary exam-btn-lg" })
                @Html.ActionLink("Back to Dashboard", "Index", "Student", null, new { @class = "exam-btn exam-btn-secondary exam-btn-lg" })
            </div>
        </div>
    </div>
</div>

<!-- Student Profile Display Start -->
<div class="exam-card">
    <div class="exam-card-content">
        <!-- Profile Photo Section -->
        <div class="exam-profile-photo-section">
            <div class="exam-profile-photo-container">
                @if (!string.IsNullOrEmpty(Model.Stud_Photo))
                {
                    <img src="@Url.Content("~/Content/StudentPhotos/"+Model.Stud_Id + Model.Stud_Photo)" alt="Student Photo" class="exam-profile-photo">
                }
                else
                {
                    <div class="exam-no-profile-photo">
                        <i class="fas fa-user-circle"></i>
                    </div>
                }
            </div>
            <div class="exam-profile-basic-info">
                <h2 class="exam-profile-name">@Model.Stud_Name</h2>
                <p class="exam-profile-username">@Model.Stud_UserName</p>
                <span class="exam-profile-badge">Student ID: #@Model.Stud_Id</span>
            </div>
        </div>

        <!-- Personal Information Section -->
        <div class="exam-form-section">
            <h3 class="exam-form-section-title">Personal Information</h3>
            <div class="exam-grid exam-grid-cols-2">
                <!-- Name Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Name)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_Name
                    </div>
                </div>

                <!-- Mobile Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Mobile)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_Mobile
                    </div>
                </div>

                <!-- Date of Birth Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_DOB)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_DOB.ToString("MMM dd, yyyy")
                    </div>
                </div>

                <!-- Gender Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Gender)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_Gender
                    </div>
                </div>
            </div>
        </div>

        <!-- Academic Information Section -->
        <div class="exam-form-section">
            <h3 class="exam-form-section-title">Academic Information</h3>
            <div class="exam-grid exam-grid-cols-2">
                <!-- Username Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_UserName)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_UserName
                    </div>
                </div>

                <!-- Password Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Password)
                    </label>
                    <div class="exam-form-display">
                        <span class="exam-password-masked">••••••••••</span>
                    </div>
                </div>

                <!-- Admission Date Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_AdmissionDate)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_AdmissionDate.ToString("MMM dd, yyyy")
                    </div>
                </div>

                <!-- Class Field -->
                <div class="exam-form-group">
                    <label class="exam-form-label">
                        @Html.LabelFor(model => model.Stud_Class)
                    </label>
                    <div class="exam-form-display">
                        @Model.Stud_Class
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
