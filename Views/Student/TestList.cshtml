@model IEnumerable<OnlineExamination.Models.TestStudent>

@{
    ViewBag.Title = "Test List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="text-center">Upcoming Test</h2>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ph ph-warning-circle"></i> <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12 text-end">
          
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            No tests available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Id</th>
                        <th>Test Name</th>
                        <th>Duration</th>
                        
                        
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TS_StartTime</td>
                            <td>@item.TS_TestId</td>
                            <td>@item.Test_Name</td>
                            <td>@item.Test_Duration</td>
                            
                            <td>
                                <a href="@Url.Action("TestDetails", "Student", new { id = item.TS_Id })" class="btn btn-success btn-sm">Start Test</a>
                                <a href="@Url.Action("Details", "Test", new { id = item.TS_Id })" class="btn btn-info btn-sm">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    
</div>
