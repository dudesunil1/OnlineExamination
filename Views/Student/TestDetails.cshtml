@model OnlineExamination.Models.TestSubjectDetailsModel

@{
    ViewBag.Title = "CET Exam Instructions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript" async
        src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js?config=TeX-MML-AM_CHTML"></script>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="exam-instructions">
    <!-- Exam Name -->
    <div class="exam-header">
        <h2>@Model.SubjectName</h2>
        @*<h4>Test Name: @Model.TestName</h4>*@
    </div>

    <!-- Exam Time, Marks, and Duration -->
    <div class="exam-details">
        <h3>Exam Details</h3>
        <div class="exam-time-info">
            <span><strong>Start Time:</strong> @Model.TestStartTime.ToString("MMMM dd, yyyy hh:mm tt")</span>
            <span class="separator">|</span>
            <span><strong>End Time:</strong> @Model.TestEndTime.ToString("MMMM dd, yyyy hh:mm tt")</span>
            <span class="separator">|</span>
            <span><strong>Duration:</strong> @Model.TestDuration</span>
        </div>
        <ul class="exam-details-list">
            <li><strong>Total Marks:</strong> @Model.TestMark</li>
            <li><strong>Number of Questions:</strong> @Model.NumberOfQuestions</li>
        </ul>
        @* Debug info - Remove in production *@
        <input type="hidden" id="debugTestId" value="@Model.TestID" />
        <input type="hidden" id="debugTsId" value="@Model.TS_Id" />
    </div>

    <!-- Instructions -->
    <div class="exam-instructions-section">
        <h3><i class="ph ph-info"></i> General Instructions</h3>
        <ol class="instructions-list">
            <li>This exam consists of <strong>@Model.NumberOfQuestions questions</strong> with a total of <strong>@Model.TestMark marks</strong>.</li>
            <li>The exam duration is <strong>@Model.TestDuration</strong>. A countdown timer will be displayed at the top of the screen.</li>
            <li>Each question has <strong>four options (A, B, C, D)</strong>. Only one option is correct.</li>
            <li>Questions can be answered in <strong>any order</strong>. Use the question palette to navigate between questions.</li>
            <li>The exam will be <strong>auto-submitted</strong> when the timer reaches zero.</li>
            <li>Make sure you have a <strong>stable internet connection</strong> throughout the exam.</li>
            <li><strong>Do not refresh</strong> the page or navigate away during the exam.</li>
            <li>You can review and change your answers before final submission.</li>
        </ol>
    </div>

    <!-- Question Navigation Instructions -->
    <div class="navigation-instructions-section">
        <h3><i class="ph ph-compass"></i> Question Navigation & Status</h3>
        <div class="status-grid">
            <div class="status-item">
                <div class="status-box not-visited">1</div>
                <p><strong>Not Visited</strong><br>Question not yet viewed</p>
            </div>
            <div class="status-item">
                <div class="status-box not-answered">2</div>
                <p><strong>Not Answered</strong><br>Viewed but not answered</p>
            </div>
            <div class="status-item">
                <div class="status-box answered">3</div>
                <p><strong>Answered</strong><br>Question answered</p>
            </div>
            <div class="status-item">
                <div class="status-box marked-review">4</div>
                <p><strong>Marked for Review</strong><br>To be reviewed later</p>
            </div>
            <div class="status-item">
                <div class="status-box answered-marked">5</div>
                <p><strong>Answered & Marked</strong><br>Answered but marked for review</p>
            </div>
        </div>
    </div>

    <!-- Answering Instructions -->
    <div class="answering-instructions-section">
        <h3><i class="ph ph-pencil-line"></i> How to Answer Questions</h3>
        <ul class="instructions-list">
            <li><strong>To Select an Answer:</strong> Click on one of the four option buttons (A, B, C, D).</li>
            <li><strong>To Deselect an Answer:</strong> Click the "Clear Response" button.</li>
            <li><strong>To Save & Move Next:</strong> Click "Save & Next" to save your answer and move to the next question.</li>
            <li><strong>To Mark for Review:</strong> Click "Mark for Review & Next" if you want to review the question later.</li>
            <li><strong>To Navigate:</strong> Use "Previous" and "Next" buttons or click on question numbers in the palette.</li>
            <li><strong>To Change an Answer:</strong> Simply select a different option and click "Save & Next".</li>
        </ul>
    </div>

    <!-- Important Rules -->
    <div class="exam-rules-section">
        <h3><i class="ph ph-warning"></i> Important Rules & Guidelines</h3>
        <div class="rules-important">
            <div class="rule-item warning">
                <i class="ph ph-clock"></i>
                <div>
                    <strong>Time Management</strong>
                    <p>Keep track of time. The exam will auto-submit when time expires.</p>
                </div>
            </div>
            <div class="rule-item warning">
                <i class="ph ph-prohibit"></i>
                <div>
                    <strong>No Malpractice</strong>
                    <p>Any form of cheating or malpractice will result in disqualification.</p>
                </div>
            </div>
            <div class="rule-item info">
                <i class="ph ph-floppy-disk"></i>
                <div>
                    <strong>Save Regularly</strong>
                    <p>Your answers are saved automatically when you click "Save & Next".</p>
                </div>
            </div>
            <div class="rule-item info">
                <i class="ph ph-check-circle"></i>
                <div>
                    <strong>Final Submission</strong>
                    <p>Click "Submit Exam" when you're done. You can review before submitting.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Checkbox -->
    <div class="confirmation-section">
        <label class="confirmation-checkbox">
            <input type="checkbox" id="confirmInstructions">
            <span>I have read and understood all the instructions and rules</span>
        </label>
    </div>

    <!-- Start Exam Button -->
    <div class="start-button">
        <button id="startExamBtn" class="btn btn-success" disabled onclick="startExam()">
            <i class="ph ph-play-circle"></i> Start Exam
        </button>
        <p class="start-note">Please check the box above to enable the Start button</p>
    </div>
</div>

<script>
    // Enable start button when checkbox is checked
    document.getElementById('confirmInstructions').addEventListener('change', function() {
        const startBtn = document.getElementById('startExamBtn');
        if (this.checked) {
            startBtn.disabled = false;
            startBtn.classList.add('enabled');
        } else {
            startBtn.disabled = true;
            startBtn.classList.remove('enabled');
        }
    });

    function startExam() {
        // Validate test ID
        var testId = @Model.TestID;
        if (!testId || testId === 0) {
            alert('Error: Invalid test ID. Please contact your administrator.');
            console.error('Invalid TestID:', testId);
            return;
        }

        // Show confirmation dialog
        if (confirm('Are you ready to start the exam? Once started, the timer will begin immediately.')) {
            console.log('Navigating to exam with testId:', testId);
            window.location.href = '@Url.Action("TakeExam", "Student", new { testId = @Model.TestID })';
        }
    }
</script>

<style>
    :root {
        --primary-blue: #4A90E2;
        --primary-green: #27AE60;
        --primary-orange: #F39C12;
        --primary-red: #E74C3C;
        --light-blue: #EBF5FB;
        --light-green: #E8F8F5;
        --light-orange: #FEF5E7;
        --light-red: #FADBD8;
        --text-dark: #2C3E50;
        --text-light: #7F8C8D;
        --white: #FFFFFF;
        --gray-light: #F8F9FA;
        --shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .exam-instructions {
        max-width: 1000px;
        margin: 30px auto;
        padding: 0;
        background-color: var(--white);
    }

    .exam-header {
        background: linear-gradient(135deg, var(--primary-blue) 0%, #5DADE2 100%);
        color: var(--white);
        padding: 40px;
        border-radius: 12px 12px 0 0;
        text-align: center;
        box-shadow: var(--shadow);
    }

    .exam-header h2 {
        font-size: 2.5em;
        margin: 0 0 10px 0;
        font-weight: 700;
    }

    .exam-header h4 {
        font-size: 1.3em;
        margin: 0;
        opacity: 0.95;
    }

    .exam-details {
        background: var(--white);
        padding: 30px;
        border-left: 4px solid var(--primary-blue);
        border-right: 4px solid var(--primary-blue);
        box-shadow: var(--shadow);
    }

    .exam-details h3 {
        font-size: 1.6em;
        color: var(--text-dark);
        margin: 0 0 20px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .exam-time-info {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 20px;
        font-size: 1.05em;
        color: var(--text-dark);
        background: var(--light-blue);
        padding: 15px;
        border-radius: 8px;
    }

    .exam-time-info span {
        flex: 1;
        min-width: 200px;
    }

    .separator {
        margin: 0 10px;
        font-weight: bold;
        color: var(--primary-blue);
    }

    .exam-details-list {
        list-style-type: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
    }

    .exam-details-list li {
        background: var(--light-green);
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid var(--primary-green);
        font-size: 1.05em;
    }

    .exam-instructions-section,
    .navigation-instructions-section,
    .answering-instructions-section,
    .exam-rules-section {
        background: var(--white);
        padding: 30px;
        margin-top: 2px;
        border-left: 4px solid var(--primary-blue);
        border-right: 4px solid var(--primary-blue);
        box-shadow: var(--shadow);
    }

    .exam-instructions-section h3,
    .navigation-instructions-section h3,
    .answering-instructions-section h3,
    .exam-rules-section h3 {
        font-size: 1.5em;
        color: var(--text-dark);
        margin: 0 0 20px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--light-blue);
    }

    .exam-instructions-section h3 i,
    .navigation-instructions-section h3 i,
    .answering-instructions-section h3 i,
    .exam-rules-section h3 i {
        font-size: 1.2em;
        color: var(--primary-blue);
    }

    .instructions-list {
        padding-left: 25px;
        line-height: 2;
    }

    .instructions-list li {
        margin: 15px 0;
        font-size: 1.05em;
        color: var(--text-dark);
    }

    .instructions-list li strong {
        color: var(--primary-blue);
    }

    /* Status Grid */
    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .status-item {
        text-align: center;
        padding: 15px;
        background: var(--gray-light);
        border-radius: 8px;
        transition: transform 0.3s ease;
    }

    .status-item:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
    }

    .status-box {
        width: 50px;
        height: 50px;
        margin: 0 auto 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 1.2em;
        font-weight: 700;
        border: 2px solid;
    }

    .status-box.not-visited {
        background: var(--white);
        color: var(--text-dark);
        border-color: #ccc;
    }

    .status-box.not-answered {
        background: #E74C3C;
        color: var(--white);
        border-color: #C0392B;
    }

    .status-box.answered {
        background: #27AE60;
        color: var(--white);
        border-color: #229954;
    }

    .status-box.marked-review {
        background: #9B59B6;
        color: var(--white);
        border-color: #8E44AD;
    }

    .status-box.answered-marked {
        background: #3498DB;
        color: var(--white);
        border-color: #2980B9;
    }

    .status-item p {
        margin: 0;
        font-size: 0.95em;
        color: var(--text-dark);
        line-height: 1.4;
    }

    .status-item strong {
        display: block;
        margin-bottom: 5px;
    }

    /* Rules Important */
    .rules-important {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .rule-item {
        display: flex;
        gap: 15px;
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid;
    }

    .rule-item.warning {
        background: var(--light-orange);
        border-color: var(--primary-orange);
    }

    .rule-item.info {
        background: var(--light-blue);
        border-color: var(--primary-blue);
    }

    .rule-item i {
        font-size: 2em;
        flex-shrink: 0;
    }

    .rule-item.warning i {
        color: var(--primary-orange);
    }

    .rule-item.info i {
        color: var(--primary-blue);
    }

    .rule-item strong {
        display: block;
        font-size: 1.1em;
        margin-bottom: 5px;
        color: var(--text-dark);
    }

    .rule-item p {
        margin: 0;
        color: var(--text-light);
        line-height: 1.5;
    }

    /* Confirmation Section */
    .confirmation-section {
        background: var(--light-green);
        padding: 25px;
        margin-top: 2px;
        border-left: 4px solid var(--primary-green);
        border-right: 4px solid var(--primary-green);
        box-shadow: var(--shadow);
    }

    .confirmation-checkbox {
        display: flex;
        align-items: center;
        gap: 15px;
        cursor: pointer;
        font-size: 1.1em;
        color: var(--text-dark);
        font-weight: 600;
    }

    .confirmation-checkbox input[type="checkbox"] {
        width: 24px;
        height: 24px;
        cursor: pointer;
    }

    /* Start Button */
    .start-button {
        text-align: center;
        padding: 40px;
        background: var(--white);
        border-radius: 0 0 12px 12px;
        border-left: 4px solid var(--primary-blue);
        border-right: 4px solid var(--primary-blue);
        border-bottom: 4px solid var(--primary-blue);
        box-shadow: var(--shadow);
    }

    .start-button .btn {
        padding: 18px 50px;
        font-size: 1.3em;
        background: #BDC3C7 !important;
        color: var(--white) !important;
        border: none !important;
        border-radius: 50px;
        cursor: not-allowed;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .start-button .btn.enabled {
        background: linear-gradient(135deg, var(--primary-green) 0%, #58D68D 100%) !important;
        cursor: pointer !important;
        box-shadow: 0 6px 20px rgba(39, 174, 96, 0.3);
    }

    .start-button .btn.enabled:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(39, 174, 96, 0.4);
    }

    .start-button .btn i {
        font-size: 1.2em;
    }

    .start-note {
        margin: 15px 0 0 0;
        color: var(--text-light);
        font-size: 0.95em;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .exam-header {
            padding: 30px 20px;
        }

        .exam-header h2 {
            font-size: 1.8em;
        }

        .exam-details,
        .exam-instructions-section,
        .navigation-instructions-section,
        .answering-instructions-section,
        .exam-rules-section {
            padding: 20px;
        }

        .exam-time-info {
            flex-direction: column;
            gap: 10px;
        }

        .status-grid,
        .rules-important {
            grid-template-columns: 1fr;
        }

        .start-button .btn {
            padding: 15px 40px;
            font-size: 1.1em;
        }
    }
</style>
